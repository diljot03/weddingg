# Leave both blank to run in demo mode (data lives in this browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Host code used only in demo mode. In production the code lives in the
# app_secrets table (see supabase/schema.sql) and never reaches the browser.
NEXT_PUBLIC_DEMO_HOST_CODE=HOST2027
